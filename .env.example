# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_ALLOWED_USER_ID=0            # your numeric Telegram user id (only this id may talk to the bot)

# --- OpenRouter (LLM) ---
OPENROUTER_API_KEY=sk-or-your-key
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash

# --- Airtable (secondary inbox + mirror) ---
AIRTABLE_TOKEN=pat-your-token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE=Tasks
AIRTABLE_INBOX_VIEW=Inbox

# --- Owner / scheduling ---
OWNER_NAME=YourName
TIMEZONE=Europe/Moscow
MORNING_TIME=08:30                    # HH:MM local — morning digest
WEEKLY_TIME=19:00                     # HH:MM local — Sunday weekly ritual

# --- Storage ---
DATABASE_PATH=data/nudge.db

# --- Personal archive (Karakeep on same VPS; UI only via Tailscale) ---
KARAKEEP_API_URL=http://127.0.0.1:3000
KARAKEEP_API_KEY=                     # Settings → API Keys in Karakeep UI
APIFY_TOKEN=                          # optional — TikTok/Reels transcript enrich
